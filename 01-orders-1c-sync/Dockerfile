# PHP 8.1 CLI. Alpine — самый лёгкий образ с нужной версией PHP.
# Скрипт использует только стандартные функции, никаких дополнительных
# расширений (mbstring, pdo, gd…) не требуется.

FROM php:8.1-cli-alpine

# Рабочий каталог внутри контейнера
WORKDIR /app

# Копируем только то, что нужно для работы скрипта.
# .dockerignore отсеивает reports/, logs/, .git и т.п.
COPY . /app

# Каталоги под отчёты и логи создаст сам скрипт, но на всякий случай
# гарантируем, что права не подкачают.
RUN mkdir -p /app/reports /app/logs

# По умолчанию запускаем sync.php без аргументов (данные из ./data/).
CMD ["php", "bin/sync.php"]
